// Schema Prisma — CompreFi v2
// Abordagem híbrida: imagens no frontend, preços e disponibilidade no backend

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// Auth
// ============================================

model User {
  id       String    @id @default(uuid())
  name     String   
  email    String    @unique   
  password String   
  products Product[]
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

// ============================================
// Produtos (modelo flat legado — mantido para compatibilidade com funil de troca)
// ============================================

model Product {
  id               String   @id @default(uuid())
  model            String
  storage          String?
  color            String
  battery          String?
  originalPrice    String
  installmentPrice String
  pixPrice         String
  details          String
  image            String?
  realImages       String[]
  category         String
  specs            String
  
  cost             Float?
  freight          Float?
  
  isActive         Boolean  @default(true)
  isNew            Boolean  @default(true)
  
  user             User     @relation(fields: [userId], references: [id])
  userId           String
  
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("products")
}

// ============================================
// Catálogo GroupedProduct (v2)
// ============================================

model ProductGroup {
  id          String   @id @default(cuid())
  slug        String   @unique        // ex: "iphone-17-pro-max"
  model       String                  // ex: "iPhone 17 Pro Max"
  category    String                  // ex: "iphones-novos"
  section     String?                 // ex: "Linha M5", "iPad Pro", "Ultra" (para sub-seções)
  specs       String?                 // descrição técnica
  details     String?                 // ex: "aparelho novo"
  battery     String?                 // ex: "100%"
  storages    String[]                // ex: ["256GB", "512GB", "1TB"]
  
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)    // ordem de exibição dentro da categoria
  
  variants    ProductVariant[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@index([category, section])
  @@map("product_groups")
}

model ProductVariant {
  id               String   @id @default(cuid())
  
  storage          String                  // ex: "256GB"
  color            String                  // ex: "Prata"
  
  originalPrice    String                  // ex: "R$ 9.469,00"
  installmentPrice String                  // ex: "R$ 830,84"
  pixPrice         String                  // ex: "R$ 8.743"
  
  isActive         Boolean  @default(true)
  
  productGroup     ProductGroup @relation(fields: [productGroupId], references: [id], onDelete: Cascade)
  productGroupId   String
  
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([productGroupId, storage, color])
  @@index([productGroupId])
  @@map("product_variants")
}

// ============================================
// Configurações
// ============================================

model Category {
  id          String   @id @default(uuid())
  name        String   @unique
  slug        String   @unique
  description String?
  isActive    Boolean  @default(true)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("categories")
}

model ProductImage {
  id        String   @id @default(uuid())
  productId String
  imageUrl  String
  imageType String
  order     Int      @default(0)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("product_images")
}

model PriceConfig {
  id                String   @id @default(uuid())
  name              String   @unique
  freightValue      Float    @default(100)
  pixMultiplier     Float    @default(0.9)
  installmentDiv1   Float    @default(0.8651)
  installmentDiv2   Int      @default(12)
  originalPricePerc Float    @default(1.2)
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("price_configs")
}

// ============================================
// Troca
// ============================================

model ValorTroca {
  id          String   @id @default(cuid())
  modelo      String
  capacidade  String
  valorBase   Float    @map("valor_base")
  ativo       Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("valores_troca")
  @@unique([modelo, capacidade])
}

model QuestionarioTroca {
  id                String   @id @default(cuid())
  modeloAtual       String   @map("modelo_atual")
  capacidadeAtual   String   @map("capacidade_atual")
  corAtual          String   @map("cor_atual")
  bateriaAtual      Int      @map("bateria_atual")
  defeitos          Json?
  pecasTrocadas     Boolean  @default(false) @map("pecas_trocadas")
  quaisPecas        String?  @map("quais_pecas")
  modeloDesejado    String   @map("modelo_desejado")
  ondeOuviu         String?  @map("onde_ouviu")
  tempoPensando     String?  @map("tempo_pensando")
  urgenciaTroca     String?  @map("urgencia_troca")
  valorAparelho     Float?   @map("valor_aparelho")
  valorFinal        Float?   @map("valor_final")
  temDefeito        Boolean  @default(false) @map("tem_defeito")
  precisaCotacao    Boolean  @default(false) @map("precisa_cotacao")
  nome              String?
  email             String?
  whatsapp          String?
  etapaAtual        Int      @default(1) @map("etapa_atual")
  concluido         Boolean  @default(false)
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@map("questionario_troca")
}
