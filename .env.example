# Ambiente
NODE_ENV="development"
PORT=3000

# Banco de dados PostgreSQL
DATABASE_URL="postgresql://usuario:senha@localhost:5432/comprefi?schema=public"

# JWT — use uma chave aleatória com pelo menos 32 caracteres
SECRET_KEY="substitua-por-uma-chave-segura-de-32-caracteres-ou-mais"
EXPIRES_IN="24h"

# Frontend autorizado pelo CORS em produção
FRONTEND_URL="https://www.comprefi.com"

# DataCrazy — webhook da página Trocar de iPhone
DATACRAZY_TRADE_WEBHOOK_URL="https://api.datacrazy.io/substitua-pelo-endpoint-real"

# Google Sheets API (opcional)
GOOGLE_CLIENT_EMAIL="conta-de-servico@projeto.iam.gserviceaccount.com"
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nSUBSTITUA_AQUI\n-----END PRIVATE KEY-----"
GOOGLE_SHEET_ID="substitua-pelo-id-da-planilha"

# SMTP (opcional)
SMTP_USER="usuario@exemplo.com"
SMTP_PASS="substitua-pela-senha"
